# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beeproof_db
DB_USER=beeproof_user
DB_PASSWORD=BeeProofSecret2026!

# Spring Backend Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security (Must be at least 256 bits for HS256 / 512 bits for HS512)
JWT_SECRET=beeproofSuperSecretKeyForJwtSigningMustBeAtLeast256BitsLong2026Secure!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

